{
    "name": "oprocs",
    "version": "0.3.2",
    "private": true,
    "description": "Run multiple processes in parallel and monitor their output",
    "author": "Odin94",
    "repository": "github:Odin94/oprocs",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:app": "tauri build",
        "build:win": "tauri build --bundles nsis",
        "build:mac": "tauri build --bundles app,dmg",
        "build:linux": "tauri build --bundles appimage",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm test && cargo test --manifest-path src-tauri/Cargo.toml",
        "dev": "tauri dev",
        "dev:web": "vite",
        "fmt": "oxfmt . --write",
        "fmt:check": "oxfmt . --check",
        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "preview": "vite preview",
        "test": "vitest run",
        "test:e2e": "vitest run src/renderer/desktop.e2e.test.ts src/renderer/App.e2e.test.tsx",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
        "version:patch": "node scripts/set-version.mjs patch",
        "version:minor": "node scripts/set-version.mjs minor",
        "version:major": "node scripts/set-version.mjs major"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.2.8",
        "@fontsource-variable/jetbrains-mono": "5.2.8",
        "@fontsource-variable/nunito": "5.2.7",
        "@leeoniya/ufuzzy": "^1.0.19",
        "@tauri-apps/api": "^2.11.1",
        "@tauri-apps/plugin-dialog": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2.5.4",
        "@tauri-apps/plugin-process": "^2.3.1",
        "@tauri-apps/plugin-updater": "^2.10.1",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-virtuoso": "^4.18.7",
        "sonner": "^2.0.7",
        "strip-ansi": "^7.2.0"
    },
    "devDependencies": {
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.5.0",
        "jsdom": "26.1.0",
        "oxfmt": "^0.51.0",
        "oxlint": "^1.66.0",
        "postcss": "^8.5.15",
        "tailwindcss": "^3.4.19",
        "typescript": "^6.0.3",
        "vite": "^7.3.3",
        "vitest": "^4.1.7"
    },
    "packageManager": "pnpm@10.33.0"
}
